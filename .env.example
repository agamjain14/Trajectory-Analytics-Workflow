# ============================================================
# Trajectory Analytics Workflow - Environment Configuration
# ============================================================
# Copy to .env — for LOCAL mode defaults work out of the box.
# For CLOUD mode: fill in the Azure section.
# ============================================================

# --- Deployment Mode ---
# "local" = Docker Compose (Ollama + app + observability)
# "cloud" = Azure Container Apps + Azure OpenAI
DEPLOY_MODE=local

# --- LLM Backend ---
# "ollama" for local, "azure" for Azure OpenAI
LLM_BACKEND=ollama

# --- Ollama (local mode) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
SUMMARY_MODEL=llama3.2
EVAL_MODEL=llama3.2

# --- Azure OpenAI (cloud mode) ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Judge LLM (quality scoring) ---
# "ollama" = same model judges itself (fast, less accurate)
# "azure" = GPT-4o-mini judges llama3.2 (accurate hallucination detection)
JUDGE_BACKEND=ollama

# --- Data ---
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_db

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=trajectory-analytics
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.version=1.0.0

# --- Pulsar ---
PULSAR_URL=pulsar://pulsar:6650

# --- MCP Tool Server ---
MCP_SERVER_URL=http://localhost:8001

# --- Application ---
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_TRACES=true
ENABLE_LOGS=true

# --- Vast.ai (data collection phase only) ---
# NODE_1_URL=http://node1-ip:11434
# NODE_2_URL=http://node2-ip:11434
# NODE_1_ID=node-1
# NODE_2_ID=node-2

# --- Azure Container Apps (cloud deploy) ---
# AZURE_RG=trajectory-rg
# AZURE_LOCATION=eastus
# AZURE_ACR=trajectoryacr
# AZURE_APP=trajectory-analytics
# AZURE_ENV=trajectory-env
# IMAGE_TAG=latest
